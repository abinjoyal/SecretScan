# SecretScan Ignore Patterns
# Similar to .gitignore - specify files, folders, or wildcards to skip during scanning

# Ignore virtual environments
venv/
.venv/
env/

# Ignore build & cache directories
build/
dist/
__pycache__/
.pytest_cache/
reports/

# Ignore tests folder (optional)
tests/
test/

# Ignore lock files
package-lock.json
yarn.lock
